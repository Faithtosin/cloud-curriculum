---
interface Props {
	title: string;
	href: string;
	cta: string;
}
const { title, href, cta } = Astro.props;
---

<div class="cta not-content">
	<div>
		<h2>{title}</h2>
		<p><slot /></p>
	</div>
	<a href={href}>{cta} <span aria-hidden="true">→</span></a>
</div>

<style>
	.cta {
		margin-top: 3rem;
		padding: 2rem;
		border-radius: calc(var(--cc-radius) + 4px);
		border: 1px solid var(--cc-card-border);
		background:
			radial-gradient(600px 200px at 100% 0%, var(--cc-glow), transparent 70%),
			var(--cc-card);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
	}

	h2 {
		margin: 0;
		font-size: var(--sl-text-h3);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}

	p {
		margin: 0.35rem 0 0;
		color: var(--sl-color-gray-2);
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
		text-decoration: none;
		box-shadow: 0 6px 20px var(--cc-glow);
		white-space: nowrap;
	}

	a:hover {
		filter: brightness(1.08);
	}
</style>
